<?xml version="1.0" encoding="utf-8"?>
<!--
  SWITCHY — ชั้นพื้นหลังของไอคอน (adaptive icon 108x108)

  พื้นเข้มแบบกระจก: น้ำเงินเกือบดำ เรืองขึ้นเล็กน้อยจากมุมซ้ายบน
  สี/ระยะวัดจากแบบ D ใน design/appicon/ (icons.css → .d)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="6"
                android:gradientRadius="128"
                android:startColor="#121A26"
                android:centerColor="#0A0F16"
                android:endColor="#05070A" />
        </aapt:attr>
    </path>

    <!-- ไฮไลต์เฉียงด้านบน (ความเงาแบบกระจก) -->
    <path
        android:fillAlpha="0.055"
        android:fillColor="#FFFFFF"
        android:pathData="M0,0h108L0,64z" />
</vector>
