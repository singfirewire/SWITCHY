<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tally_unknown">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- แถวบน: รหัสกล้อง + สถานะการเชื่อมต่อ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCameraCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="CAM1"
                android:textColor="#F2F6FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/not_connected"
                android:textColor="#F2F6FA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ข้อความล่าสุดจากศูนย์ควบคุม (แตะเพื่อเปิดจอข้อความ) -->
        <TextView
            android:id="@+id/tvBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:padding="10dp"
            android:textColor="@color/txt"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ชื่อกล้อง + สถานะใหญ่กลางจอ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCameraName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="กล้อง 1"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.14"
                android:text="@string/state_unknown"
                android:textColor="#EAF0F6"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvVmix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#D7E2EC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ระดับไมค์ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/label_mic"
                android:textColor="#EAF0F6"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbMic"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvMicDb"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="—"
                android:textColor="#EAF0F6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- วิทยุ/เพื่อนร่วมงาน -->
        <TextView
            android:id="@+id/tvPeers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#D7E2EC"
            android:textSize="12sp" />

        <!-- สลับกล้อง -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rowCameras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ตัวเลือกการทำงานของเสียง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#EAF0F6"
                android:text="@string/label_gate"
                android:textColor="#EAF0F6"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbMute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#EAF0F6"
                android:text="@string/label_mute_while_talk"
                android:textColor="#EAF0F6"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ปุ่ม PTT -->
        <Button
            android:id="@+id/btnPtt"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ptt"
            android:text="@string/btn_ptt"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMessages"
                style="@style/SwitchyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_messages" />

            <Button
                android:id="@+id/btnExit"
                style="@style/SwitchyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_exit" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
